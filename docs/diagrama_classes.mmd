%% UFJ Survivors - diagrama de classes
%% Grupo: Filipe Duarte de Freitas Oliveira, Thaller Subtil de Carvalho
classDiagram
    direction TB
    class Entidade {
        <<abstract>>
        +posicao: Vector2
        +raio: float
        +ativo: bool
        +atualizar(dt, jogo)*
        +desenhar(tela, camera)*
        +remover()
    }
    class SerVivo {
        <<abstract>>
        -_vida: float
        +vida: float «property»
        +vida_maxima: float «property»
        +receber_dano(q) bool
        +curar(q)
    }
    class Jogador {
        <<abstract>>
        +armas: list~Arma~
        +itens: list~Item~
        +especial: Especial
        +habilidades: list~Habilidade~
        +chance_critico: float
        +criar_arma_inicial()* Arma
        +criar_habilidades()* list~Habilidade~
        +criar_especial()* Especial
        +ganhar_experiencia(q) int
        +aplicar_colab(receita, jogo)
    }
    class Otaku
    class Programador
    class MestreDeRPG
    class Monitor
    class Gamer
    class Calouro
    class CaraDaCarona
    class Inimigo {
        <<abstract>>
        +mover(dt, jogo)*
        +ao_morrer(jogo)
        +possuir(duracao)
        +tornar_gigante()
    }
    class Bug
    class CalculadoraBrava
    class MouseDeBolinha
    class Caixinha
    class CaixinhaPequena
    class PiCambaleante
    class Ponteiro
    class PilhaAA
    class PenteDeRAM
    class Chefe {
        <<abstract>>
        +ataques()* list
    }
    class ChefePossuido {
        <<abstract>>
        +materias: list~Materia~
        +materia: Materia «property»
        +nome: str «property»
        +receber_dano(q) bool
        +proteger(duracao)
    }
    class ProfessorDeCalculo
    class ProfessorDeArquiteturaEED
    class ProfessoraDeTDEPOO
    class Materia {
        <<abstract>>
        +NOME: str
        +VIDA: int
        +ataques()* list
        +leque(chefe, jogo, n)
        +anel(chefe, jogo, n)
        +rajada(chefe, vezes, intervalo, disparo)
        +chamada(chefe, jogo, n)
    }
    class CalculoI
    class CalculoII
    class ArquiteturaDeComputadores
    class EstruturaDeDadosEmC
    class TransformacaoDigital
    class ProgramacaoOrientadaAObjetos
    class AcaoDoChefe {
        <<abstract>>
        +#95;#95;call#95;#95;(dt, jogo)* bool
        +desenhar_aviso(tela, camera)
    }
    class Investida
    class Rajada
    class Projetil {
        <<abstract>>
        +verificar_colisao(jogo)*
    }
    class ProjetilDoHeroi
    class ProjetilInimigo
    class Ajudante {
        <<abstract>>
    }
    class Coletavel {
        <<abstract>>
        +ao_coletar(jogo)*
        +puxar_experiencia()
    }
    class ObjetoQuebravel {
        <<abstract>>
        +ao_morrer(jogo)
    }
    class Efeito {
        <<abstract>>
    }
    class Arma {
        <<abstract>>
        -_nivel: int
        +nivel: int «property»
        +atualizar(dt, jogo, dono)*
        +#95;#95;str#95;#95;()
    }
    class ArmaDeDisparo {
        <<abstract>>
        -_espera: float
        +espera: float «property»
        +disparar(jogo, dono)* bool
    }
    class ArmaContinua {
        <<abstract>>
    }
    class Colab {
        <<abstract>>
        +colabs_disponiveis(armas)$ list
    }
    class Item {
        <<abstract>>
        +aplicar(jogador)*
        +atualizar(dt, jogador, jogo)
        +ao_subir_de_nivel(jogador, jogo)
    }
    class Especial {
        <<abstract>>
        +cargas: int
        +cargas_maximas: int «property»
        +ativar(dono, jogo)*
        +agir(dt, dono, jogo)
        +medidor_extra «property»
    }
    class ViradaDeNoite {
        +garrafa: GarrafaDeCafe
    }
    class GarrafaDeCafe {
        -_municao: int
        +municao: int «property»
        +capacidade: int «property»
        +gastar(doses) bool
        +encher()
    }
    class ReageAoJogo {
        +atualizar(dt, jogador, jogo)
        +ao_acertar(inimigo, jogador, jogo)
        +ao_eliminar(inimigo, jogador, jogo)
        +ao_ser_atingido(dano, jogador, jogo) float
        +ao_rolar(jogador, jogo)
    }
    class Habilidade {
        <<abstract>>
        +nivel: int «property»
        +aplicar(jogador)*
    }
    class InstintoOtaku
    class Rolamento {
        +rolando: bool
        +iniciar(direcao) bool
        +atualizar(dt, mult_recarga)
    }
    class Melhoria {
        <<abstract>>
        +custo(nivel)$ int
        +aplicar(jogador)*
    }
    class Progresso {
        +moedas: int
        +comprar_melhoria(m) bool
        +desbloquear(classe) bool
        +comprar_lanche(classe) bool
        +consumir_lanche()
        +conquistas: frozenset «property»
    }
    class Lanche {
        <<abstract>>
        +aplicar(jogador)*
    }
    class Conquista {
        <<abstract>>
        +alcancada(jogo, progresso)* bool
    }
    class ConquistaDeMarco
    class RoletaDoBandejao
    class JogoDeAposta {
        <<abstract>>
        +sorteios()*
        +avaliar(sorteio, escolha)*
        +jogar(aposta, escolha, rng)
        +tabela(escolha)
        +retorno_esperado(escolha)
    }
    class MaquinaDeSalgadinho
    class DadoDoMestre
    class Jogo {
        +entidades: list~Entidade~
        +fase: Fase
        +chefes: list~Chefe~
        +a_partir_de(classe, opcoes)$ Jogo
        +iniciar_chefe(chefe, prova)
        +aprovar(chefe)
        +atualizar(dt)
        +causar_dano(inimigo, dano)
    }
    class Fase {
        <<abstract>>
        +criar_eventos()* list
        +escala_dificuldade «property»
        +furia «property»
        +alvo_de_inimigos() int
        +posicao_de_nascimento(jogo)$
    }
    class Semestre {
        +provas: tuple~ProvaMarcada~
        +APRESENTACOES: tuple
        +escala_dificuldade «property»
        +adiantar_para_a_prova(prova)
    }
    class ProvaMarcada {
        +hora: float
        +chefe: str
        +materia: str
    }
    class Placar {
        -_pontos: int
        +pontos: int «property»
        +registrar_eliminacao(p) bool
        +#95;#95;str#95;#95;()
    }
    class RegistroRanking {
        +#95;#95;lt#95;#95;(outro)
        +#95;#95;eq#95;#95;(outro)
        +#95;#95;str#95;#95;()
    }
    class FabricaDeInimigos {
        +registrar(nome)$
        +criar(nome, posicao, escala)$ Inimigo
    }
    class Colisao {
        +circulos_colidem(a, b)$ bool
        +segmento_acerta_circulo(...)$ bool
        +empurrar_para_fora(c, r, poligono)$ Vector2
    }

    class Mapa {
        <<abstract>>
        +arena: Rect
        +inicio: Vector2
        +entidades()* list
        +desenhar_chao(tela, camera)*
        +empurrar(posicao, raio) Vector2
    }
    class MapaUFJ {
        +carregar(rng)$ MapaUFJ
    }
    class Cenario
    class Predio {
        +poligono: list
        +esta_visivel(camera) bool
    }
    class Decoracao
    class OpcoesDePartida {
        +prova: ProvaMarcada
        +treino: bool
        +direto_no_chefe: bool
        +imortal: bool
        +criar_fase() Semestre
    }
    class Animador {
        +atual: str
        +tocar(nome)
        +quadro_atual
    }
    class Animacao {
        +quadros: list
        +quadro(tempo)
    }

    Entidade <|-- SerVivo
    Entidade <|-- Projetil
    Entidade <|-- Ajudante
    Entidade <|-- Coletavel
    Entidade <|-- Efeito
    SerVivo <|-- Jogador
    SerVivo <|-- Inimigo
    Jogador <|-- Otaku
    Jogador <|-- Programador
    Jogador <|-- MestreDeRPG
    Jogador <|-- Monitor
    Jogador <|-- Gamer
    Jogador <|-- Calouro
    Jogador <|-- CaraDaCarona
    ReageAoJogo <|-- Habilidade
    ReageAoJogo <|-- Item
    Habilidade <|-- InstintoOtaku
    Especial <|-- ViradaDeNoite
    ViradaDeNoite *-- GarrafaDeCafe
    Inimigo <|-- Bug
    Inimigo <|-- CalculadoraBrava
    Inimigo <|-- MouseDeBolinha
    Inimigo <|-- Caixinha
    Caixinha <|-- CaixinhaPequena
    Inimigo <|-- PiCambaleante
    Inimigo <|-- Ponteiro
    Inimigo <|-- PilhaAA
    Inimigo <|-- MiniChefe
    Inimigo <|-- ObjetoQuebravel
    MiniChefe <|-- TiaDaCantina
    MiniChefe <|-- Vigilante
    MiniChefe <|-- Bibliotecaria
    MiniChefe <|-- TecnicoDoLaboratorio
    MiniChefe <|-- Reitor
    MiniChefe <|-- LoboGuara
    MiniChefe <|-- GraoMestreDoCulto
    MiniChefe <|-- GoticaTrevosa
    MiniChefe <|-- ETDeVarginha
    MiniChefe <|-- LeaoDoProerd
    MiniChefe <|-- Motorizado
    Motorizado <|-- LoiraDaOdontologia
    Motorizado <|-- Agroboy
    Vigilante *-- Arrancada
    LoboGuara *-- Arrancada
    Inimigo <|-- LacaioDoCampus
    Entidade <|-- LocalDeInvocacao
    LocalDeInvocacao ..> MiniChefe : invoca
    Inimigo <|-- PenteDeRAM
    Inimigo <|-- Chefe
    Chefe <|-- ChefePossuido
    ChefePossuido <|-- ProfessorDeCalculo
    ChefePossuido <|-- ProfessorDeArquiteturaEED
    ChefePossuido <|-- ProfessoraDeTDEPOO
    ChefePossuido *-- Materia
    Materia <|-- CalculoI
    Materia <|-- CalculoII
    Materia <|-- ArquiteturaDeComputadores
    Materia <|-- EstruturaDeDadosEmC
    Materia <|-- TransformacaoDigital
    Materia <|-- ProgramacaoOrientadaAObjetos
    Chefe o-- AcaoDoChefe
    AcaoDoChefe <|-- Investida
    AcaoDoChefe <|-- Rajada
    Projetil <|-- ProjetilDoHeroi
    Projetil <|-- ProjetilInimigo
    Arma <|-- ArmaDeDisparo
    Arma <|-- ArmaContinua
    Arma <|-- Colab
    Fase <|-- Semestre
    Semestre o-- ProvaMarcada : calendário

    Jogo *-- Jogador
    Jogo *-- Fase : o semestre
    Jogo *-- Placar
    Jogo *-- Mapa
    Mapa <|-- MapaUFJ
    Mapa <|-- Cenario
    Entidade <|-- Predio
    Entidade <|-- Decoracao
    MapaUFJ *-- Predio
    Jogador *-- Animador
    Inimigo *-- Animador
    Animador o-- Animacao
    Jogo o-- Entidade
    Jogador *-- Arma
    Jogador *-- Item
    Jogador *-- Especial
    Jogador *-- Habilidade : 0..3
    Jogador *-- Rolamento
    Jogador o-- Melhoria
    Progresso ..> Melhoria : compra
    JogoDeAposta <|-- MaquinaDeSalgadinho
    JogoDeAposta <|-- DadoDoMestre
    JogoDeAposta <|-- RoletaDoBandejao
    Conquista <|-- ConquistaDeMarco
    Progresso ..> Lanche : guarda
    Progresso ..> Conquista : registra
    Jogo ..> OpcoesDePartida : a_partir_de
    Fase ..> FabricaDeInimigos : usa
    FabricaDeInimigos ..> Inimigo : cria
    Jogo ..> Colisao : usa
    Placar ..> RegistroRanking : vira
