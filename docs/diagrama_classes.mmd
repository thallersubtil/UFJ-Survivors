classDiagram
    direction TB
    class Entidade {
        <<abstract>>
        +posicao: Vector2
        +raio: float
        +ativo: bool
        +atualizar(dt, jogo)*
        +desenhar(tela, camera)*
        +remover()
    }
    class SerVivo {
        <<abstract>>
        -_vida: float
        +vida: float «property»
        +vida_maxima: float «property»
        +receber_dano(q) bool
        +curar(q)
    }
    class Jogador {
        <<abstract>>
        +armas: list~Arma~
        +itens: list~Item~
        +especial: Especial
        +criar_arma_inicial()* Arma
        +criar_especial()* Especial
        +ganhar_experiencia(q) int
        +aplicar_colab(receita, jogo)
    }
    class AlunoAgil
    class AlunoResistente
    class Inimigo {
        <<abstract>>
        +mover(dt, jogo)*
        +ao_morrer(jogo)
        +possuir(duracao)
        +tornar_gigante()
    }
    class Bug
    class CalculadoraBrava
    class MouseDeBolinha
    class Caixinha
    class CaixinhaPequena
    class PiCambaleante
    class Ponteiro
    class PilhaAA
    class PenteDeRAM
    class Chefe {
        <<abstract>>
        +ataques()* list
    }
    class ChefePossuido {
        <<abstract>>
        +materias: list~Materia~
        +materia: Materia «property»
        +nome: str «property»
        +receber_dano(q) bool
        +proteger(duracao)
    }
    class ProfessorDeCalculo
    class ProfessorDeArquiteturaEED
    class ProfessoraDeTDEPOO
    class Materia {
        <<abstract>>
        +NOME: str
        +VIDA: int
        +ataques()* list
        +leque(chefe, jogo, n)
        +anel(chefe, jogo, n)
        +rajada(chefe, vezes, intervalo, disparo)
        +chamada(chefe, jogo, n)
    }
    class CalculoI
    class ArquiteturaDeComputadores
    class EstruturaDeDadosEmC
    class TransformacaoDigital
    class ProgramacaoOrientadaAObjetos
    class AcaoDoChefe {
        <<abstract>>
        +#95;#95;call#95;#95;(dt, jogo)* bool
        +desenhar_aviso(tela, camera)
    }
    class Investida
    class Rajada
    class Projetil {
        <<abstract>>
        +verificar_colisao(jogo)*
    }
    class ProjetilDoHeroi
    class ProjetilInimigo
    class Ajudante {
        <<abstract>>
    }
    class Coletavel {
        <<abstract>>
        +ao_coletar(jogo)*
    }
    class Efeito {
        <<abstract>>
    }
    class Arma {
        <<abstract>>
        -_nivel: int
        +nivel: int «property»
        +atualizar(dt, jogo, dono)*
        +#95;#95;str#95;#95;()
    }
    class ArmaDeDisparo {
        <<abstract>>
        -_municao: float
        +municao: float «property»
        +disparar(jogo, dono)* bool
    }
    class ArmaDeContato {
        <<abstract>>
    }
    class Colab {
        <<abstract>>
        +colabs_disponiveis(armas)$ list
    }
    class Item {
        <<abstract>>
        +aplicar(jogador)*
    }
    class Especial {
        <<abstract>>
        +ativar(dono, jogo)*
    }
    class Jogo {
        +entidades: list~Entidade~
        +fases: list~Fase~
        +a_partir_de(classe, opcoes)$ Jogo
        +concluir_fase()
        +atualizar(dt)
        +causar_dano(inimigo, dano)
    }
    class Fase {
        <<abstract>>
        +criar_eventos()* list
        +posicao_de_nascimento(jogo)$
    }
    class Prova {
        <<abstract>>
        +CHEFE: str
        +APRESENTACOES: tuple
        +adiantar_para_o_chefe()
    }
    class ProvaDeCalculo
    class ProvaDeArquiteturaEED
    class ProvaDeTDEPOO
    class Placar {
        -_pontos: int
        +pontos: int «property»
        +registrar_eliminacao(p) bool
        +#95;#95;str#95;#95;()
    }
    class RegistroRanking {
        +#95;#95;lt#95;#95;(outro)
        +#95;#95;eq#95;#95;(outro)
        +#95;#95;str#95;#95;()
    }
    class FabricaDeInimigos {
        +registrar(nome)$
        +criar(nome, posicao, escala)$ Inimigo
    }
    class Colisao {
        +circulos_colidem(a, b)$ bool
        +segmento_acerta_circulo(...)$ bool
        +empurrar_para_fora(c, r, poligono)$ Vector2
    }

    class Mapa {
        <<abstract>>
        +arena: Rect
        +inicio: Vector2
        +entidades()* list
        +desenhar_chao(tela, camera)*
        +empurrar(posicao, raio) Vector2
    }
    class MapaUFJ {
        +carregar(rng)$ MapaUFJ
    }
    class Cenario
    class Predio {
        +poligono: list
        +esta_visivel(camera) bool
    }
    class Decoracao
    class Aparencia {
        -_escolhas: dict
        +pele: str «property»
        +cabelo: str «property»
        +moletom: str «property»
        +calca: str «property»
        +recolorir(imagem) Surface
        +#95;#95;eq#95;#95;(outra)
        +#95;#95;hash#95;#95;()
        +#95;#95;str#95;#95;()
    }
    class OpcoesDePartida {
        +provas: tuple
        +treino: bool
        +direto_no_chefe: bool
        +imortal: bool
        +criar_fases() list
    }
    class Animador {
        +atual: str
        +tocar(nome)
        +quadro_atual
    }
    class Animacao {
        +quadros: list
        +quadro(tempo)
    }

